# TrueConnect Environment Configuration
# Copy to .env and fill in values

# App
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:3000,https://trueconnect.kz,https://www.trueconnect.kz

# PostgreSQL
PG_HOST=postgres
PG_PORT=5432
PG_USER=tc_app
PG_PASSWORD=changeme_pg_password
PG_DBNAME=trueconnect
PG_SSLMODE=disable

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_neo4j_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password
REDIS_DB=0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_minio_secret
MINIO_USE_SSL=false
MINIO_BUCKET=trueconnect

# Auth
JWT_SECRET=changeme_must_be_at_least_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Encryption key for PII fields (32 bytes, hex-encoded)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=REPLACE_ME_RUN_openssl_rand_hex_32_________________________________
